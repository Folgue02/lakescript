// `Customer` and `Status` are in this folder, so they need no `use`
pub class Order {
    pub string @item;
    pub number @cents;
    pub Customer @customer;
    pub Status @status = Status::PENDING;

    pub void pay() {
        @status = Status::PAID;
    }

    pub string label() = f"{@item} for {@customer.name} ({@status.name().lower()})";
}
