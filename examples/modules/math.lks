// Imported modules only have declarations: functions, `const`, `let` and `type`.

pub const $golden = (1 + 5 ** 0.5) / 2;

// A `let` is the module's own state: only its functions can change it
let $averages = 0;

pub number average(list<number> $values) {
    $averages += 1;
    return $values.sum() / $values.length();
}

pub number averagesSoFar() = $averages;

// Type aliases can be shared too
pub type Stat = (list<number>) -> number;

pub number clamp(number $n, number $low, number $high) = $n.clamp($low, $high);

// Not `pub`: only this file can use it
number helper() = 42;
