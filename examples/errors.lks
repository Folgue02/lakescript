#!/usr/bin/lks
// Exceptions, try/catch/finally, and `try` that returns a result.

number parsePort(string $text) {
    const $port = $text.toNumber();       // throws a ValueError if it isn't a number
    if (!$port.between(1, 65535))
        throw ValueError(f"{$port} isn't a valid port");
    return $port;
}

for ($input in ['8080', 'eighty', '99999']) {
    try {
        outln(f"Port {parsePort($input)}");
    } catch (ValueError $e) {
        outln(f"Bad port '{$input}': {$e.message()}");
    } finally {
        outln('  (checked)');
    }
}

// A type catches the exceptions under it
try {
    throw FileNotFound('config.txt');
} catch (IOError $e) {
    outln(f"{$e.typeName()} is an IOError: {$e.is(IOError)}");
}

// Every runtime error has a type. Most type errors are found before the
// script runs; with `any` values, they can only be found while it runs.
any $text = 'a';
any $data = {'a' => 1};
const $attempts = [
    () -> [1, 2][5],
    () -> 10 % 0,
    () -> $text + 1,
    () -> $data['a'].as(string),
];
for ($attempt in $attempts) {
    try {
        $attempt();
    } catch ($e) {
        outln($e.typeName());
    }
}

// `try` as an expression gives a result instead of throwing
const $ok = try parsePort('443');
const $bad = try parsePort('nope');
outln($ok);
outln($bad.isError());
outln($bad.orElse(80));
outln($ok.map(($p) -> $p + 1).orNull());
outln((try parsePort('22')).orElse(80));

// `throw` is also an expression, for a missing value or an impossible case
string portName(?number $port) = switch ($port ?? throw ValueError('no port given')) {
    case 80 -> 'http';
    case 443 -> 'https';
    default -> 'other';
};
outln(portName(443));
outln((try portName(null)).isError());

// Custom exceptions are classes that extend a built-in one. They get the
// field `message` first, and `catch` finds them by their class or by the
// exceptions above it
class ConfigError extends ValueError {
    pub string @file;
}

class MissingKey extends ConfigError {
    pub string @key;

    pub new(@key, string $file) {
        @super(f"`{@key}` is missing", $file);
    }
}

void readConfig(map<string, any> $config) {
    if ('port' -notin $config.keys()) {
        throw MissingKey('port', 'app.json');
    }
}

try {
    readConfig({'host' => 'localhost'});
} catch (MissingKey $e) {
    outln(f"{$e.file}: {$e.message()} (the key was {$e.key})");
}

try {
    throw ConfigError('the port must be a number', file: 'app.json');
} catch (ValueError $e) {
    outln(f"{$e.typeName()}: {$e.message()}");
}

// `$e.trace()` gives the calls an exception was thrown through, the first
// one first and where it was thrown last. A caught exception prints nothing on
// its own; one that isn't caught shows these calls above the error
number portNumber(string $value) = $value.toNumber();
number portOf(map<string, string> $config) = portNumber($config['port'] ?? '');

try {
    portOf({'port' => 'eighty'});
} catch (ValueError $e) {
    outln(f"{$e.message()}, through {$e.trace().length()} calls:");
    for ($call in $e.trace()) {
        // Only the name of the file, without its folders
        outln('  ' + $call.replaceMatches(%r"\(.*/", '('));
    }
}

// `unimplemented` stands for code that isn't written yet: it throws a
// `NotImplemented`, and `lks --check` warns about each one that's left
string exportAs(string $format) = switch ($format) {
    case 'json' -> '{}';
    default -> unimplemented f"exporting as {$format}";
};
try {
    exportAs('xml');
} catch (NotImplemented $e) {
    outln($e.message());
}

// `assert` can say what went wrong, after a `,`
const $retries = 0;
try {
    assert $retries > 0, 'there must be at least one retry';
} catch (AssertionError $e) {
    outln($e.message());
}
