#!/usr/bin/lks
// Running commands. `%x"..."` runs a program directly, without a shell, so a
// command behaves the same on Linux, macOS and Windows.

use std/process;

// %x"..." is a command; it runs when a method is called
const $kernel = %x"uname -s".output();
outln(f"Running on {$kernel}");

// Spaces separate the arguments, and quotes keep spaces in one
outln(%x"printf '[%s]' 'two words' three".output());

// A value is always whole arguments, so it never runs as code
const $tricky = 'a file; echo hacked';
outln(%x"printf '<%s>' {$tricky}".output());

// A list becomes several arguments
const $words = ['one', 'two words', 'three'];
outln(%x"printf '[%s]' {$words}".output());

// There's no shell, so `|`, `$` and `*` are plain text
outln(%x"printf '[%s]' a|b $HOME *".output());

// Pipes and files are methods
outln(%x"printf 'b\na\nc\n'".pipe(%x"sort").lines());
%x"printf 'saved\n'".writeTo('/tmp/lks-example.txt').run();
%x"printf 'and more\n'".appendTo('/tmp/lks-example.txt').run();
outln(%x"sort".readFrom('/tmp/lks-example.txt').lines());

// Setting up a command before running it
outln(%x"tr a-z A-Z".input('quiet please').output());
outln(%x"pwd".cwd('/').output());

// Exit codes
outln(%x"false".status());
outln(%x"true".succeeds?());

// A failing command throws a CommandFailed
try {
    %x"ls /surely/not/here".quiet().run();
} catch (CommandFailed $e) {
    outln($e.message());
}
outln((try %x"git describe --tags".quiet().output()).orElse('no tags here'));

// When a shell is really needed: `sh -c` on Linux and macOS, `cmd /C` on Windows
outln(process::shell('echo $MOOD | tr a-z A-Z').env('MOOD', 'happy').output());

if (process::which('git') != null)
    outln('git is installed');

// run() sends the output straight to the terminal
%x"echo 'Printed by the command itself'".run();
