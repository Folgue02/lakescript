#!/usr/bin/lks
// Tests: functions named test..., checked with `assert`.
// Run them with `lks --test examples/testing.lks`, or only some with a
// filter: `lks --test examples/testing.lks Slug`. In a ferry project they go
// in tests/, and `ferry test` runs them.

use std/fs;
use std/path;
use std/test;

// The code being tested
string slug(string $title) = $title.withoutAccents().trim().lower().replaceMatches(%r"[^a-z0-9]+", '-').trimEnd('-');

number average(list<number> $values) {
    if ($values.empty?()) throw ValueError('there are no values');
    return $values.sum() / $values.length();
}

// `assert` checks a condition. When a comparison fails, it shows both sides
void testSlug() {
    assert slug('Hello World') == 'hello-world';
    assert slug('  Lakescript 1.0!  ') == 'lakescript-1-0';
}

void testSlugOfNothing() {
    assert slug('') == '';
}

void testSlugWithoutAccents() {
    assert slug('Crème Brûlée à la Ñandú') == 'creme-brulee-a-la-nandu';
}

// `beforeEach` and `afterEach` run around every test of the file, and
// `test::tempDir()` is a folder that's removed when the test ends
let string $notes = '';

void beforeEach() {
    $notes = path::join(test::tempDir(), 'notes.txt');
}

void afterEach() {
    assert !fs::exists?($notes) || fs::read($notes) == 'buy milk';
}

void testNotesInATemporaryFolder() {
    fs::write($notes, 'buy milk');
    assert fs::read($notes) == 'buy milk';
}

void testAverage() {
    assert average([1, 2, 3]) == 2;
    assert average([5]) == 5;
}

// `test::throws` runs the code and gives back the exception it threw
void testAverageOfNothing() {
    const $e = test::throws(() -> average([]));
    assert $e.typeName() == 'ValueError';
    assert $e.message() == 'there are no values';
}

// Any script can use `assert`, and after it the checker knows the condition holds
void testAssertNarrows() {
    ?string $first = ['lake'].first();
    assert $first != null;
    assert $first.upper() == 'LAKE';
}

// Functions whose names don't start with `test` are helpers
void testHelpers() {
    checkSlug('A  B', 'a-b');
}

void checkSlug(string $title, string $expected) {
    assert slug($title) == $expected;
}
