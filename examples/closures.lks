#!/usr/bin/lks
// Anonymous functions and closures.

// One line: the expression after `=` is the value
const $double = ($n) -> $n * 2;
outln($double(21));

// With types and a block
const $describe = (string $name, number $age) {
    const $stage = $age < 18 ? 'young' : 'adult';
    return f"{$name} is {$age} ({$stage})";
};
outln($describe('Daniel', 23));

// Passed to methods: the parameter types come from the list
const $fruits = %w[apple banana cherry];
outln($fruits.map(($f) -> $f.capitalize()).join(', '));
outln($fruits.filter(($f) -> $f.contains('an')));
// One parameter without a type needs no parentheses
outln(f"{$fruits.map($f -> $f.length()).sum()} letters in all");

// Closures keep the variables they use, like in JavaScript
(() -> number) makeCounter() {
    let $count = 0;
    return () -> ++$count;
}

const $next = makeCounter();
$next();
$next();
outln(f"The counter is at {$next()}");

// They see later changes, and each loop pass keeps its own variable
let $greeting = 'Hello';
const $greet = ($name) -> f"{$greeting}, {$name}";
$greeting = 'Bye';
outln($greet('world'));

let $printers = [];
for ($i in 1..=3)
    $printers << () -> $i * 10;
outln($printers.map(($p) -> $p()));

// Functions are values too: named ones can be passed by name
number square(number $n) = $n ** 2;
number applyTwice((number) -> number $f, number $x) = $f($f($x));
outln(applyTwice(square, 3));

// Functions can call each other in any order, even one declared further down
bool even?(number $n) = if ($n == 0) true else odd?($n - 1);
bool odd?(number $n) = if ($n == 0) false else even?($n - 1);
outln(f"7 is odd: {odd?(7)}");
