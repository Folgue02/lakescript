//! The project a script is in, read from its `ferry.toml` and `ferry.lock`
//! *(see ideas/stdlib/tooling/ferry.md)*, for the project's own scripts that
//! `ferry task` runs. Its Rust part, `std/tooling/ferry/native`, reads them
//! with the same code as ferry.

use std/fs;
use std/path;
use std/process;
use std/tooling/ferry/native;

/// A dependency of a project, as its `ferry.toml` asks for it.
pub class Dependency {
    /// Its package *(i.e. `github:acme/http`)*.
    pub const string @package;
    /// What `ferry.toml` asks for: a version, or a range *(i.e. `^1.4.2`)*.
    pub const string @wanted;
    /// The version `ferry.lock` has, or `null` before ferry chose one.
    pub const ?string @version;
}

/// A ferry project: what its `ferry.toml` says, and where its folders are.
pub class Project {
    /// Its ID, the one its modules are written with *(i.e. `folgue02/backup`)*.
    pub const string @id;
    pub const string @author;
    pub const string @name;
    pub const string @version;
    /// `'application'` or `'library'`.
    pub const string @kind;
    /// The oldest Lakescript it needs, or `null` if it doesn't say.
    pub const ?string @lks;
    /// Its folder, the one with `ferry.toml`.
    pub const string @dir;
    /// Its dependencies, in the order of `ferry.toml`.
    pub const list<Dependency> @dependencies;

    /// Its `src/` folder.
    pub string src() = path::join(@dir, 'src');

    /// Its `bin/` folder, with its commands.
    pub string bin() = path::join(@dir, 'bin');

    /// Its `tests/` folder.
    pub string tests() = path::join(@dir, 'tests');

    /// Its `scripts/` folder, with its tasks.
    pub string scripts() = path::join(@dir, 'scripts');

    /// Its `resources/` folder.
    pub string resources() = path::join(@dir, 'resources');

    /// The names of its commands, the scripts of `bin/`, sorted.
    pub list<string> commands() = scriptsIn(@bin());

    /// The names of its tasks, the scripts of `scripts/`, sorted.
    pub list<string> tasks() = scriptsIn(@scripts());
}

/// The project of the folder `$from`, or of the current one: the first
/// `ferry.toml` in it or in the folders above it. Throws a `FileNotFound` if
/// there's none, and a `ValueError` with ferry's message if its `ferry.toml`
/// or `ferry.lock` is wrong.
pub Project project(?string $from = null) {
    const $p = native::project(path::absolute($from ?? process::cwd()));
    const $dependencies = <Dependency>[];
    for ($d in $p[7].as(list<list<any>>)) {
        $dependencies.push(Dependency($d[0].as(string), $d[1].as(string), $d[2]?.as(string)));
    }
    return Project(
        id: $p[0].as(string),
        author: $p[1].as(string),
        name: $p[2].as(string),
        version: $p[3].as(string),
        kind: $p[4].as(string),
        lks: $p[5]?.as(string),
        dir: $p[6].as(string),
        dependencies: $dependencies,
    );
}

// Like ferry, the `.lks` files of a folder, without the hidden ones
list<string> scriptsIn(string $folder) {
    if (!fs::dir?($folder)) return [];
    return fs::list($folder)
        .filter(($name) -> $name.endsWith('.lks') && !$name.startsWith('.') && fs::file?(path::join($folder, $name)))
        .map(($name) -> $name.removeSuffix('.lks'))
        .sorted();
}
