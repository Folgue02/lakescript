// `std/terminal/Style`: the styles of `terminal::style()`, colors, backgrounds
// and effects in one enum *(see ideas/stdlib/terminal.md)*. Its own module,
// so `use std/terminal/Style;` gives `Style` itself.

/// A color, a background *(`ON_...`)* or an effect for `terminal::style()`
/// *(i.e. `terminal::style('error', Style::RED, Style::BOLD)`)*. A terminal
/// that doesn't have one ignores it.
pub enum Style {
    BLACK,
    RED,
    GREEN,
    YELLOW,
    BLUE,
    MAGENTA,
    CYAN,
    WHITE,
    BRIGHT_BLACK,
    BRIGHT_RED,
    BRIGHT_GREEN,
    BRIGHT_YELLOW,
    BRIGHT_BLUE,
    BRIGHT_MAGENTA,
    BRIGHT_CYAN,
    BRIGHT_WHITE,
    GRAY,
    ORANGE,
    PINK,
    PURPLE,
    BROWN,
    ON_BLACK,
    ON_RED,
    ON_GREEN,
    ON_YELLOW,
    ON_BLUE,
    ON_MAGENTA,
    ON_CYAN,
    ON_WHITE,
    ON_BRIGHT_BLACK,
    ON_BRIGHT_RED,
    ON_BRIGHT_GREEN,
    ON_BRIGHT_YELLOW,
    ON_BRIGHT_BLUE,
    ON_BRIGHT_MAGENTA,
    ON_BRIGHT_CYAN,
    ON_BRIGHT_WHITE,
    ON_GRAY,
    ON_ORANGE,
    ON_PINK,
    ON_PURPLE,
    ON_BROWN,
    BOLD,
    DIM,
    ITALIC,
    UNDERLINE,
    DOUBLE_UNDERLINE,
    CURLY_UNDERLINE,
    OVERLINE,
    STRIKE,
    BLINK,
    INVERSE,
    HIDDEN;
}
