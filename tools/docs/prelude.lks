#!/usr/bin/lks
// Generates the signatures the type checker knows for the built-in methods
// and the standard library, from the tables in ideas/stdlib. The docs are the
// source of truth, so the checker and the docs never disagree.
//
//   lks tools/docs/prelude.lks
//
// It writes crates/lakescript/src/checker/prelude.txt, or the path given. Run it after changing a
// signature in the docs, and then build `lks` again.

use std/fs;
use std/path;
use std/process;

const $repo = path::parent(path::parent(path::parent(process::scriptPath() ?? '.') ?? '.') ?? '.') ?? '.';
const $stdlib = path::join($repo, 'ideas', 'stdlib');
// Another path can be given, i.e. to compare with the committed one
const $out = process::args().empty?() ? path::join($repo, 'crates', 'lakescript', 'src', 'checker', 'prelude.txt') : process::args()[0];

// The type each file describes, with the names of its type parameters
const $types = [
    ['any', 'any'], ['string', 'string'], ['number', 'number'], ['bool', 'bool'], ['symbol', 'symbol'],
    ['regex', 'regex'], ['range', 'range'], ['command', 'command'], ['list', 'list<T>'], ['map', 'map<K, V>'],
];
const $modules = [
    ['general', 'general'], ['fs', 'std/fs'], ['path', 'std/path'], ['env', 'std/env'], ['io', 'std/io'],
    ['process', 'std/process'], ['json', 'std/json'], ['time', 'std/time'],
];

// Types described outside ideas/stdlib
const $extra = """
    type result<T, E>
    bool isOk();
    bool isError();
    T orElse(T $default);
    T orElseGet(() -> T $fn);
    result<U, E> map((T) -> U $fn);
    ?T orNull();
    T throw();
    ?E error();

    type exception
    string message();
    string typeName();
    number line();
    """;

/// The cells of a table row. `\|` is a `|` inside a cell.
list<string> cells(string $line) {
    const $marked = $line.trim().replace(r"\|", "\u{1}").trim('|');
    return $marked.split('|').map(($c) -> $c.trim().replace("\u{1}", '|'));
}

/// The signatures in the Method, Function and Constant tables of a file.
list<string> members(string $file) {
    const $lines = fs::readLines($file);
    const $result = <string>[];
    let $i = 0;
    while ($i < $lines.length()) {
        const $row = $lines[$i].trim();
        const $kind = $row.startsWith('|') ? cells($row)[0] : '';
        if ($kind -in ['Method', 'Function', 'Constant']) {
            $i += 2;
            while ($i < $lines.length() && $lines[$i].trim().startsWith('|')) {
                const $c = cells($lines[$i]);
                const $member = $c[0].trim('`');
                const $returns = $c[1].trim('`');
                // `.as()` and `.is()` take a type, and the checker handles them itself
                if (!$member.startsWith('as(') && !$member.startsWith('is(')) {
                    $result.push($kind == 'Constant' ? f"const {$returns} {$member};" : f"{$returns} {$member};");
                }
                $i += 1;
            }
            continue;
        }
        $i += 1;
    }
    return $result;
}

const $parts = ["# Generated by tools/docs/prelude.lks from ideas/stdlib. Don't edit it by hand."];
for ([$name, $header] in $types) {
    $parts.push(f"\ntype {$header}");
    $parts.extend(members(path::join($stdlib, 'types', f"{$name}.md")));
}
for ([$name, $header] in $modules) {
    $parts.push(f"\nmodule {$header}");
    $parts.extend(members(path::join($stdlib, f"{$name}.md")));
}
$parts.push("\n" + $extra.trimEnd());
const $text = $parts.join("\n") + "\n";
fs::write($out, $text);
outln(f"{$out}: {$text.lines().countWhere(($l) -> $l.endsWith(';'))} signatures");
